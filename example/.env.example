# Development (staging): demo endpoint demo-stg.onramper.dev
ONRAMPER_DEV_API_KEY=pk_test_your_test_key_here
ONRAMPER_DEV_CLIENT_ID=your_dev_client_id_here
ONRAMPER_DEV_DEMO_AUTH_TOKEN=your_dev_bearer_token_here

# Production: demo endpoint demo-prod.onramper.com
ONRAMPER_PROD_API_KEY=pk_prod_your_prod_key_here
ONRAMPER_PROD_CLIENT_ID=your_prod_client_id_here
ONRAMPER_PROD_DEMO_AUTH_TOKEN=your_prod_bearer_token_here

# Legacy unprefixed ONRAMPER_API_KEY / ONRAMPER_CLIENT_ID /
# ONRAMPER_DEMO_AUTH_TOKEN still work as Development values.
